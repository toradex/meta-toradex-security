From 10ab064bb9d4221a69bb26e05d510b8465bdd58f Mon Sep 17 00:00:00 2001
From: Rogerio Guerra Borin <rogerio.borin@toradex.com>
Date: Tue, 18 Feb 2025 16:37:15 -0300
Subject: [PATCH 09/10] toradex: cmd: fuse: add readv command (upstream)

v1:

Add command "fuse readv" to allow reading fuse values into a
variable.

v2:

Limit the word count to 64 and keep the buffer size in a size_t. The
size was computed in an int from an unbounded count, so a large count
wrapped it to a few bytes and the loop wrote past the allocation.

Upstream-Status: Pending

Signed-off-by: Rogerio Guerra Borin <rogerio.borin@toradex.com>
---
 cmd/fuse.c | 50 ++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 50 insertions(+)

diff --git a/cmd/fuse.c b/cmd/fuse.c
index 3446736df0e..e30ebe54b72 100644
--- a/cmd/fuse.c
+++ b/cmd/fuse.c
@@ -13,8 +13,13 @@
 #include <console.h>
 #include <fuse.h>
 #include <mapmem.h>
+#include <malloc.h>
+#include <env.h>
 #include <linux/errno.h>
 
+/* Maximum number of words "fuse readv" reads into one variable. */
+#define TDX_FUSE_READV_MAX_WORDS	64
+
 static int strtou32(const char *str, unsigned int base, u32 *result)
 {
 	char *ep;
@@ -115,6 +120,49 @@ static int do_fuse(struct cmd_tbl *cmdtp, int flag, int argc,
 		}
 
 		unmap_sysmem(start);
+	} else if (!strcmp(op, "readv")) {
+		char *varname;
+		void *varval;
+		size_t len;
+
+		if (argc == 3)
+			cnt = 1;
+		else if (argc != 4 || strtou32(argv[3], 0, &cnt))
+			return CMD_RET_USAGE;
+
+		/* Bound the count so that the buffer size below cannot wrap. */
+		if (!cnt || cnt > TDX_FUSE_READV_MAX_WORDS)
+			return CMD_RET_USAGE;
+
+		len = cnt * ((sizeof(val) * 2) + 1) + 1;
+		varname = argv[2];
+		varval = calloc(1, len);
+		if (!varval)
+			goto err;
+
+		IF_NOT_QUIET(printf("Reading bank %u len %u into '%s'\n",
+				    bank, cnt, varname));
+		ret = 0;
+		buf = varval;
+		for (i = 0; i < cnt; i++, word++) {
+			ret = fuse_read(bank, word, &val);
+			if (ret)
+				break;
+			if (i) {
+				*((char *) buf) = ' ';
+				buf++;
+			}
+			sprintf(buf, "%lx", (ulong) val);
+			buf += strlen(buf);
+		}
+
+		if (ret) {
+			free(varval);
+			goto err;
+		}
+
+		env_set(varname, varval);
+		free(varval);
 	} else if (!strcmp(op, "cmp")) {
 		if (argc != 3 || strtou32(argv[2], 0, &cmp))
 			return CMD_RET_USAGE;
@@ -205,6 +253,8 @@ U_BOOT_CMD(
 	"    at 'word'\n"
 	"fuse readm [-q] <bank> <word> <addr> [<cnt>] - read 1 or 'cnt' fuse words,\n"
 	"    starting at 'word' into memory at 'addr'\n"
+	"fuse readv [-q] <bank> <word> <name> [<cnt>] - read 1 or 'cnt' fuse words,\n"
+	"    starting at 'word' into variable 'name'\n"
 	"fuse sense [-q] <bank> <word> [<cnt>] - sense 1 or 'cnt' fuse words,\n"
 	"    starting at 'word'\n"
 	"fuse prog [-q] [-y] <bank> <word> <hexval> [<hexval>...] - program 1 or\n"
